user {{ nginx.user | default("www www") }};

worker_processes {{ nginx.worker_processes | default("1") }};

error_log /var/log/nginx/error.log;
#pid /var/run/nginx.pid;

events {
    worker_connections {{ nginx.worker_connections | default("1024") }};
}

http {
    include mime.types;
    default_type application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    log_format metrics escape=json
                        '{"timestamp": "$time_iso8601",'
                        '"client": "$remote_addr",'
                        '"method": "$request_method",'
                        '"host": "$host",'
                        '"request": "$request",'
                        '"request_length": $request_length,'
                        '"status": $status,'
                        '"bytes_sent": $bytes_sent,'
                        '"body_bytes_sent": $body_bytes_sent,'
                        '"referer": "$http_referer",'
                        '"user_agent": "$http_user_agent",'
                        '"request_time": "$request_time"}';

    #access_log /var/log/nginx/access.log combined buffer=32k;
    #access_log syslog:server=syslog.example.com:8514 metrics;
    #access_log logs/access.log  main;

    sendfile on;
    #tcp_nopush on;

    #keepalive_timeout 0;
    keepalive_timeout 65;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_min_length 256;
    gzip_http_version 1.1;

    gzip_types
        application/javascript
        application/json
        application/rss+xml
        application/xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    server_tokens off;

    include conf.d/*.conf;
    include sites.d/*.conf;

}

